{
 "Version": "2012-10-17",
 "Statement": [
  {"Sid": "TheRunsHarnessMadeWithTheRunsTag", "Effect": "Allow", "Action": "bedrock-agentcore:CreateHarness",
   "Resource": "*", "Condition": {"Null": {"aws:RequestTag/arvaken-stop-test": "false"}}},
  {"Sid": "TheRunsHarness", "Effect": "Allow",
   "Action": ["bedrock-agentcore:GetHarness", "bedrock-agentcore:DeleteHarness", "bedrock-agentcore:InvokeHarness",
              "bedrock-agentcore:InvokeAgentRuntime", "bedrock-agentcore:InvokeAgentRuntimeForUser",
              "bedrock-agentcore:InvokeAgentRuntimeCommand", "bedrock-agentcore:TagResource",
              "bedrock-agentcore:ListTagsForResource"],
   "Resource": ["arn:aws:bedrock-agentcore:*:*:harness/arvaken_stop_test_*",
                "arn:aws:bedrock-agentcore:*:*:harness/arvaken_stop_test_*/harness-endpoint/*"]},
  {"Sid": "TheRuntimeAWSRequiresForAHarness", "Effect": "Allow",
   "Action": ["bedrock-agentcore:CreateAgentRuntime", "bedrock-agentcore:GetAgentRuntime",
              "bedrock-agentcore:DeleteAgentRuntime", "bedrock-agentcore:CreateAgentRuntimeEndpoint",
              "bedrock-agentcore:DeleteAgentRuntimeEndpoint"],
   "Resource": ["arn:aws:bedrock-agentcore:*:*:runtime/harness_arvaken_stop_test_*",
                "arn:aws:bedrock-agentcore:*:*:runtime/harness_arvaken_stop_test_*/runtime-endpoint/*"]},
  {"Sid": "TheMemoryAWSRequiresToMakeAHarnessWithTheRunsTag", "Effect": "Allow",
   "Action": "bedrock-agentcore:CreateMemory", "Resource": "*",
   "Condition": {"Null": {"aws:RequestTag/arvaken-stop-test": "false"}}},
  {"Sid": "TheMemoryAWSRequiresForAHarnessTaggedWithARun", "Effect": "Allow",
   "Action": ["bedrock-agentcore:GetMemory", "bedrock-agentcore:DeleteMemory"],
   "Resource": "arn:aws:bedrock-agentcore:*:*:memory/*",
   "Condition": {"Null": {"aws:ResourceTag/arvaken-stop-test": "false"}}},
  {"Sid": "YourModelsInferenceProfileRead", "Effect": "Allow", "Action": "bedrock:GetInferenceProfile",
   "Resource": "arn:aws:bedrock:*:*:inference-profile/*"}
 ]
}
