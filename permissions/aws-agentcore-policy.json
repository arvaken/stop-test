{
 "Version": "2012-10-17",
 "Statement": [
  {"Sid": "TheRunsRolesEachUnderTheKitsBoundary", "Effect": "Allow",
   "Action": ["iam:CreateRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:AttachRolePolicy",
              "iam:DetachRolePolicy"],
   "Resource": "arn:aws:iam::*:role/arvaken-stop-test-*",
   "Condition": {"StringLike": {"iam:PermissionsBoundary": ["arn:aws:iam::*:policy/arvaken-stop-test-boundary",
                                                            "arn:aws:iam::*:policy/arvaken-stop-test-boundary-harness"]}}},
  {"Sid": "TheRunsRoles", "Effect": "Allow",
   "Action": ["iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:ListRoleTags", "iam:ListRolePolicies",
              "iam:ListAttachedRolePolicies"],
   "Resource": "arn:aws:iam::*:role/arvaken-stop-test-*"},
  {"Sid": "TheAgentsRoleGivenToItsRuntime", "Effect": "Allow", "Action": "iam:PassRole",
   "Resource": "arn:aws:iam::*:role/arvaken-stop-test-*",
   "Condition": {"StringEquals": {"iam:PassedToService": "bedrock-agentcore.amazonaws.com"}}},
  {"Sid": "TheRunsBucketAndTheAgentsCode", "Effect": "Allow",
   "Action": ["s3:CreateBucket", "s3:DeleteBucket", "s3:ListBucket", "s3:PutBucketTagging",
              "s3:PutEncryptionConfiguration", "s3:PutBucketPublicAccessBlock", "s3:PutObject", "s3:GetObject",
              "s3:DeleteObject"],
   "Resource": ["arn:aws:s3:::arvaken-stop-test-*", "arn:aws:s3:::arvaken-stop-test-*/*"]},
  {"Sid": "TheRunsRuntimeMadeWithTheRunsTag", "Effect": "Allow", "Action": "bedrock-agentcore:CreateAgentRuntime",
   "Resource": "*",
   "Condition": {"Null": {"aws:RequestTag/arvaken-stop-test": "false"}}},
  {"Sid": "TheRunsRuntime", "Effect": "Allow",
   "Action": ["bedrock-agentcore:GetAgentRuntime", "bedrock-agentcore:DeleteAgentRuntime",
              "bedrock-agentcore:TagResource", "bedrock-agentcore:ListTagsForResource",
              "bedrock-agentcore:PutResourcePolicy", "bedrock-agentcore:GetResourcePolicy",
              "bedrock-agentcore:DeleteResourcePolicy", "bedrock-agentcore:InvokeAgentRuntime",
              "bedrock-agentcore:InvokeAgentRuntimeForUser", "bedrock-agentcore:StopRuntimeSession",
              "bedrock-agentcore:CreateAgentRuntimeEndpoint", "bedrock-agentcore:DeleteAgentRuntimeEndpoint"],
   "Resource": ["arn:aws:bedrock-agentcore:*:*:runtime/arvaken_stop_test_*",
                "arn:aws:bedrock-agentcore:*:*:runtime/arvaken_stop_test_*/runtime-endpoint/*"]},
  {"Sid": "TaggingWhatTheRunMakesWithTheRunsTag", "Effect": "Allow", "Action": "bedrock-agentcore:TagResource",
   "Resource": ["arn:aws:bedrock-agentcore:*:*:runtime/*", "arn:aws:bedrock-agentcore:*:*:harness/*",
                "arn:aws:bedrock-agentcore:*:*:workload-identity-directory/default/workload-identity/*"],
   "Condition": {"Null": {"aws:RequestTag/arvaken-stop-test": "false"}}},
  {"Sid": "TheRunsHarnessMadeWithTheRunsTag", "Effect": "Allow", "Action": "bedrock-agentcore:CreateHarness",
   "Resource": "*", "Condition": {"Null": {"aws:RequestTag/arvaken-stop-test": "false"}}},
  {"Sid": "TheRunsHarness", "Effect": "Allow",
   "Action": ["bedrock-agentcore:GetHarness", "bedrock-agentcore:DeleteHarness", "bedrock-agentcore:InvokeHarness",
              "bedrock-agentcore:InvokeAgentRuntime", "bedrock-agentcore:InvokeAgentRuntimeForUser",
              "bedrock-agentcore:InvokeAgentRuntimeCommand", "bedrock-agentcore:TagResource",
              "bedrock-agentcore:ListTagsForResource"],
   "Resource": ["arn:aws:bedrock-agentcore:*:*:harness/arvaken_stop_test_*",
                "arn:aws:bedrock-agentcore:*:*:harness/arvaken_stop_test_*/harness-endpoint/*"]},
  {"Sid": "TheRuntimeAWSRequiresForAHarness", "Effect": "Allow",
   "Action": ["bedrock-agentcore:CreateAgentRuntime", "bedrock-agentcore:GetAgentRuntime",
              "bedrock-agentcore:DeleteAgentRuntime", "bedrock-agentcore:CreateAgentRuntimeEndpoint",
              "bedrock-agentcore:DeleteAgentRuntimeEndpoint"],
   "Resource": ["arn:aws:bedrock-agentcore:*:*:runtime/harness_arvaken_stop_test_*",
                "arn:aws:bedrock-agentcore:*:*:runtime/harness_arvaken_stop_test_*/runtime-endpoint/*"]},
  {"Sid": "TheMemoryAWSRequiresToMakeAHarnessWithTheRunsTag", "Effect": "Allow",
   "Action": "bedrock-agentcore:CreateMemory", "Resource": "*",
   "Condition": {"Null": {"aws:RequestTag/arvaken-stop-test": "false"}}},
  {"Sid": "TheMemoryAWSRequiresForAHarnessTaggedWithARun", "Effect": "Allow",
   "Action": ["bedrock-agentcore:GetMemory", "bedrock-agentcore:DeleteMemory"],
   "Resource": "arn:aws:bedrock-agentcore:*:*:memory/*",
   "Condition": {"Null": {"aws:ResourceTag/arvaken-stop-test": "false"}}},
  {"Sid": "YourModelsInferenceProfileRead", "Effect": "Allow", "Action": "bedrock:GetInferenceProfile",
   "Resource": "arn:aws:bedrock:*:*:inference-profile/*"},
  {"Sid": "TheRuntimesWorkloadIdentity", "Effect": "Allow",
   "Action": ["bedrock-agentcore:CreateWorkloadIdentity", "bedrock-agentcore:GetWorkloadIdentity",
              "bedrock-agentcore:DeleteWorkloadIdentity"],
   "Resource": ["arn:aws:bedrock-agentcore:*:*:workload-identity-directory/default/workload-identity/arvaken_stop_test_*",
                "arn:aws:bedrock-agentcore:*:*:workload-identity-directory/default/workload-identity/harness_arvaken_stop_test_*"]},
  {"Sid": "TheRuntimesLogGroupsIfAny", "Effect": "Allow", "Action": "logs:DeleteLogGroup",
   "Resource": ["arn:aws:logs:*:*:log-group:/aws/bedrock-agentcore/runtimes/arvaken_stop_test_*",
                "arn:aws:logs:*:*:log-group:/aws/bedrock-agentcore/runtimes/harness_arvaken_stop_test_*"]},
  {"Sid": "YourStopReadAndChecked", "Effect": "Allow", "Action": ["iam:GetPolicy", "iam:GetPolicyVersion"],
   "Resource": "arn:aws:iam::*:policy/*"},
  {"Sid": "ReadsAwsTakesOnEveryResourceOnly", "Effect": "Allow",
   "Action": ["cloudtrail:LookupEvents", "tag:GetResources", "logs:DescribeLogGroups", "iam:SimulateCustomPolicy",
              "bedrock-agentcore:ListAgentRuntimes", "bedrock-agentcore:ListAgentRuntimeEndpoints",
              "bedrock-agentcore:ListHarnesses", "bedrock-agentcore:ListMemories"],
   "Resource": "*"},
  {"Sid": "WithTrailOnlyTheRunsTrail", "Effect": "Allow",
   "Action": ["cloudtrail:CreateTrail", "cloudtrail:AddTags", "cloudtrail:PutEventSelectors",
              "cloudtrail:StartLogging", "cloudtrail:StopLogging", "cloudtrail:GetTrail", "cloudtrail:DeleteTrail"],
   "Resource": "arn:aws:cloudtrail:*:*:trail/arvaken-stop-test-*"},
  {"Sid": "WithTrailOnlyItsBucketsPolicy", "Effect": "Allow",
   "Action": ["s3:PutBucketPolicy", "s3:DeleteBucketPolicy"],
   "Resource": "arn:aws:s3:::arvaken-stop-test-*"}
 ]
}
