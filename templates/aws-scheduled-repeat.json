{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "Arvaken stop test, repeated: once a day, asks Arvaken whether a run is due for one of your agents, and runs the stop test kit in your account only when it is. Everything here is yours to change or delete.",
 "Parameters": {
  "RunnerKeyArn": {
   "Type": "String",
   "Description": "Your Arvaken runner's KMS key ARN. The daily question is signed with it, and nothing else is.",
   "AllowedPattern": "arn:aws:kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}"
  },
  "EngagementId": {
   "Type": "String",
   "Description": "Your engagement's id, as your runner has it."
  },
  "AgentId": {
   "Type": "String",
   "Description": "The agent's id, from its page in the Arvaken app."
  },
  "StopPolicyArn": {
   "Type": "String",
   "Description": "Your declared stop: the managed policy's ARN, as you give it to stop-test aws run --stop."
  },
  "RunOptions": {
   "Type": "String",
   "Description": "More options for stop-test aws run, as you would type them. Leave it as it is for a quick run.",
   "Default": "--quick"
  },
  "KitVersion": {
   "Type": "String",
   "Description": "The stop test kit's release to install, checked against its signature before anything is installed.",
   "Default": "0.7.0",
   "AllowedPattern": "[0-9]+\\.[0-9]+\\.[0-9]+"
  }
 },
 "Resources": {
  "Results": {
   "Type": "AWS::S3::Bucket",
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain",
   "Properties": {
    "PublicAccessBlockConfiguration": {
     "BlockPublicAcls": true,
     "BlockPublicPolicy": true,
     "IgnorePublicAcls": true,
     "RestrictPublicBuckets": true
    },
    "BucketEncryption": {
     "ServerSideEncryptionConfiguration": [
      {
       "ServerSideEncryptionByDefault": {
        "SSEAlgorithm": "AES256"
       }
      }
     ]
    }
   }
  },
  "Logs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": "/aws/codebuild/arvaken-stop-test-repeat",
    "RetentionInDays": 90
   }
  },
  "KitsPolicy": {
   "Type": "AWS::IAM::ManagedPolicy",
   "Properties": {
    "Description": "The stop test kit's own policy, permissions/aws-policy.json",
    "PolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Sid": "TheRunsStack",
       "Effect": "Allow",
       "Action": [
        "cloudformation:CreateStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStackEvents"
       ],
       "Resource": "arn:aws:cloudformation:*:*:stack/arvaken-stop-test-*/*"
      },
      {
       "Sid": "TheRunsRolesEachUnderTheKitsBoundary",
       "Effect": "Allow",
       "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
       ],
       "Resource": "arn:aws:iam::*:role/arvaken-stop-test-*",
       "Condition": {
        "StringLike": {
         "iam:PermissionsBoundary": [
          "arn:aws:iam::*:policy/arvaken-stop-test-boundary",
          "arn:aws:iam::*:policy/arvaken-stop-test-boundary-via",
          "arn:aws:iam::*:policy/arvaken-stop-test-boundary-model",
          "arn:aws:iam::*:policy/arvaken-stop-test-boundary-via-model"
         ]
        }
       }
      },
      {
       "Sid": "TheRunsRoles",
       "Effect": "Allow",
       "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
       ],
       "Resource": "arn:aws:iam::*:role/arvaken-stop-test-*"
      },
      {
       "Sid": "TheAgentsRoleGivenToItsFunction",
       "Effect": "Allow",
       "Action": "iam:PassRole",
       "Resource": "arn:aws:iam::*:role/arvaken-stop-test-*",
       "Condition": {
        "StringEquals": {
         "iam:PassedToService": "lambda.amazonaws.com"
        }
       }
      },
      {
       "Sid": "TheRunsFunction",
       "Effect": "Allow",
       "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:InvokeFunction",
        "lambda:TagResource",
        "lambda:ListTags"
       ],
       "Resource": "arn:aws:lambda:*:*:function:arvaken-stop-test-*"
      },
      {
       "Sid": "TheRunsBucket",
       "Effect": "Allow",
       "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:PutBucketTagging",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:DeleteObject"
       ],
       "Resource": [
        "arn:aws:s3:::arvaken-stop-test-*",
        "arn:aws:s3:::arvaken-stop-test-*/*"
       ]
      },
      {
       "Sid": "TheFunctionsLogGroupIfAny",
       "Effect": "Allow",
       "Action": "logs:DeleteLogGroup",
       "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/arvaken-stop-test-*"
      },
      {
       "Sid": "YourStopReadAndChecked",
       "Effect": "Allow",
       "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
       ],
       "Resource": "arn:aws:iam::*:policy/*"
      },
      {
       "Sid": "ReadsAwsTakesOnEveryResourceOnly",
       "Effect": "Allow",
       "Action": [
        "cloudtrail:LookupEvents",
        "tag:GetResources",
        "logs:DescribeLogGroups",
        "iam:SimulateCustomPolicy",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs"
       ],
       "Resource": "*"
      }
     ]
    }
   }
  },
  "RunsTheKit": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "codebuild.amazonaws.com"
       },
       "Action": "sts:AssumeRole",
       "Condition": {
        "StringEquals": {
         "aws:SourceAccount": {
          "Ref": "AWS::AccountId"
         }
        }
       }
      }
     ]
    },
    "ManagedPolicyArns": [
     {
      "Ref": "KitsPolicy"
     }
    ],
    "Policies": [
     {
      "PolicyName": "ItsQuestionLogsAndResults",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Sid": "SignsTheDueQuestionWithTheRunnersKey",
         "Effect": "Allow",
         "Action": "kms:Sign",
         "Resource": {
          "Ref": "RunnerKeyArn"
         },
         "Condition": {
          "StringEquals": {
           "kms:SigningAlgorithm": "ECDSA_SHA_256"
          }
         }
        },
        {
         "Sid": "WritesItsOwnLogs",
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": {
          "Fn::Sub": "${Logs.Arn}"
         }
        },
        {
         "Sid": "KeepsItsResults",
         "Effect": "Allow",
         "Action": "s3:PutObject",
         "Resource": {
          "Fn::Sub": "${Results.Arn}/*"
         }
        }
       ]
      }
     }
    ]
   }
  },
  "Repeat": {
   "Type": "AWS::CodeBuild::Project",
   "Properties": {
    "Name": "arvaken-stop-test-repeat",
    "ServiceRole": {
     "Fn::GetAtt": [
      "RunsTheKit",
      "Arn"
     ]
    },
    "TimeoutInMinutes": 120,
    "Source": {
     "Type": "NO_SOURCE",
     "BuildSpec": "version: 0.2\nphases:\n  install:\n    commands:\n      - python3 -m venv /tmp/kit && /tmp/kit/bin/python -m pip install --quiet sigstore\n      - curl -sSfLO https://github.com/arvaken/stop-test/releases/download/v${KIT_VERSION}/requirements-${KIT_VERSION}.txt\n      - curl -sSfLO https://github.com/arvaken/stop-test/releases/download/v${KIT_VERSION}/requirements-${KIT_VERSION}.txt.sigstore.json\n      - /tmp/kit/bin/python -m sigstore verify github requirements-${KIT_VERSION}.txt --cert-identity https://github.com/arvaken/stop-test/.github/workflows/release.yml@refs/tags/v${KIT_VERSION}\n      - /tmp/kit/bin/python -m pip install --quiet --require-hashes -r requirements-${KIT_VERSION}.txt\n  build:\n    commands:\n      - |\n        set +e\n        /tmp/kit/bin/stop-test due --key \"$RUNNER_KEY_ARN\" --engagement \"$ENGAGEMENT_ID\" --agent \"$AGENT_ID\"\n        asked=$?\n        set -e\n        if [ \"$asked\" = 3 ]; then exit 0; fi\n        if [ \"$asked\" != 0 ]; then exit \"$asked\"; fi\n        /tmp/kit/bin/stop-test aws run --region \"$AWS_REGION\" --stop \"$STOP_POLICY_ARN\" $RUN_OPTIONS\n  post_build:\n    commands:\n      - for f in stop-test-*.json stop-test-*.html; do [ -e \"$f\" ] && aws s3 cp \"$f\" \"s3://$RESULTS_BUCKET/$CODEBUILD_BUILD_NUMBER/$f\"; done; true\n"
    },
    "Artifacts": {
     "Type": "NO_ARTIFACTS"
    },
    "Environment": {
     "Type": "LINUX_CONTAINER",
     "ComputeType": "BUILD_GENERAL1_SMALL",
     "Image": "aws/codebuild/amazonlinux-x86_64-standard:5.0",
     "EnvironmentVariables": [
      {
       "Name": "RUNNER_KEY_ARN",
       "Value": {
        "Ref": "RunnerKeyArn"
       }
      },
      {
       "Name": "ENGAGEMENT_ID",
       "Value": {
        "Ref": "EngagementId"
       }
      },
      {
       "Name": "AGENT_ID",
       "Value": {
        "Ref": "AgentId"
       }
      },
      {
       "Name": "STOP_POLICY_ARN",
       "Value": {
        "Ref": "StopPolicyArn"
       }
      },
      {
       "Name": "RUN_OPTIONS",
       "Value": {
        "Ref": "RunOptions"
       }
      },
      {
       "Name": "KIT_VERSION",
       "Value": {
        "Ref": "KitVersion"
       }
      },
      {
       "Name": "RESULTS_BUCKET",
       "Value": {
        "Ref": "Results"
       }
      }
     ]
    },
    "LogsConfig": {
     "CloudWatchLogs": {
      "Status": "ENABLED",
      "GroupName": {
       "Ref": "Logs"
      }
     }
    }
   }
  },
  "StartsTheRepeat": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "scheduler.amazonaws.com"
       },
       "Action": "sts:AssumeRole",
       "Condition": {
        "StringEquals": {
         "aws:SourceAccount": {
          "Ref": "AWS::AccountId"
         }
        }
       }
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "StartsThatProjectAlone",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": "codebuild:StartBuild",
         "Resource": {
          "Fn::GetAtt": [
           "Repeat",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "Daily": {
   "Type": "AWS::Scheduler::Schedule",
   "Properties": {
    "ScheduleExpression": "rate(1 day)",
    "FlexibleTimeWindow": {
     "Mode": "FLEXIBLE",
     "MaximumWindowInMinutes": 60
    },
    "Target": {
     "Arn": {
      "Fn::GetAtt": [
       "Repeat",
       "Arn"
      ]
     },
     "RoleArn": {
      "Fn::GetAtt": [
       "StartsTheRepeat",
       "Arn"
      ]
     }
    }
   }
  }
 },
 "Outputs": {
  "ResultsBucket": {
   "Value": {
    "Ref": "Results"
   }
  }
 }
}
